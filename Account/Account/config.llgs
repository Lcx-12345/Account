# LLGS Configuration File
# This is a sample configuration file for demonstration purposes

# General settings
version: 1.0
name: "Account App Configuration"
description: "Default configuration for the Account application"

# Debug settings
debug:
  enabled: true
  logLevel: "info"
  logFile: "debug.log"

# API settings
api:
  baseURL: "https://api.example.com"
  timeout: 30
  retryCount: 3

# Feature flags
features:
  enableNotifications: true
  enableDarkMode: false
  enableAnalytics: true

# Cache settings
cache:
  maxSize: 100
  maxAge: 86400

# Network settings
network:
  useSSL: true
  proxyEnabled: false
  proxyHost: ""
  proxyPort: 8080
